# ─────────────────────────────────────────────────────────────────────────────
# services.wisdmlabs.com — integration contract
# Copy to .env.local and fill real values BEFORE launch. Build works with blanks
# (form simulates submit + redirect; conversion tags no-op until IDs are present).
# ─────────────────────────────────────────────────────────────────────────────

# HubSpot Forms API (form submit → Contact + Deal)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_FORM_GUID=

# HubSpot Meetings scheduler embed (rendered on /thank-you)
NEXT_PUBLIC_HUBSPOT_MEETINGS_URL=

# GA4 — fires page_view + generate_lead on /thank-you load
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads conversion — fires on /thank-you load
NEXT_PUBLIC_GADS_CONVERSION_ID=
NEXT_PUBLIC_GADS_CONVERSION_LABEL=

# Meta (Facebook) Pixel — fires PageView on all pages + Lead on /thank-you
NEXT_PUBLIC_META_PIXEL_ID=

# Resend — email notification to sales team on form submit
RESEND_API_KEY=
RESEND_FROM_EMAIL=WisdmLabs Services <noreply@services.wisdmlabs.com>
